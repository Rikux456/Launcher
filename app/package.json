{
  "name": "derisomod-launcher",
  "productName": "Derisomod Launcher",
  "version": "2.0.4",
  "description": "Launcher del modpack Derisomod",
  "author": "Rikux456",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "selftest": "electron . --selftest",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.rikux456.derisomod.launcher",
    "productName": "Derisomod Launcher",
    "asar": false,
    "files": ["main.js", "preload.js", "core.js", "selftest.js", "renderer/**/*", "build/icon.ico", "package.json"],
    "directories": { "output": "dist" },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "artifactName": "Derisomod-Launcher-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Derisomod Launcher",
      "deleteAppDataOnUninstall": false
    },
    "publish": [{ "provider": "github", "owner": "Rikux456", "repo": "Launcher", "releaseType": "release" }]
  }
}
